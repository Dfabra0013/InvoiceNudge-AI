# InvoiceNudge AI — Variables de entorno
# Copia este archivo a .env y rellena los valores antes de ejecutar en producción.

# Puerto del servidor
PORT=3000

# Secreto para firmar JWT (cámbialo en producción)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES=7d

# Proveedor de IA: 'openrouter' para usar un proveedor real, 'none' para plantillas
AI_PROVIDER=none
# Clave API del proveedor de IA (solo backend, nunca exponer al frontend)
AI_API_KEY=
# URL base del proveedor (OpenRouter-compatible)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# Stripe (opcional, solo para planes de pago reales)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Intervalo del programador de automatizaciones (ms)
SCHEDULER_INTERVAL_MS=60000
